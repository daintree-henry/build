# Build environment
FROM maven:3.6-jdk-11 
WORKDIR /app

# Copy pom.xml and the src/ directory
COPY pom.xml .
COPY src ./src

# Build the application
RUN mvn clean package

# Copy the built JAR file into the runtime environment
RUN cp /app/target/*.jar ./app.jar

# Run the application
EXPOSE 8080
CMD ["java", "-jar", "app.jar"]
